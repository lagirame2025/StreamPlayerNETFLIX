<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cari judul lalu tekan Enter"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <CheckBox
        android:id="@+id/cbTranscode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Transcode (HLS) - centang jika video tidak mau diputar" />

    <TextView
        android:id="@+id/tvLibStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp" />

    <ListView
        android:id="@+id/lvMedia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keluar / ganti server" />
</LinearLayout>
